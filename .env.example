# ── Environment template ──
# Copy to .env.local and fill in values as you add features.
# The app currently runs with ZERO variables — everything below is optional/future.

# ── Public (inlined into browser JS — NEVER put secrets here) ──
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Server-only (Node runtime only, never exposed to the browser) ──
# DATABASE_URL=
# RESEND_API_KEY=

# ── Vercel Analytics ──
# No key required. @vercel/analytics auto-configures on Vercel deployments.
# On self-hosted deployments it silently collects nothing.
